{
  "entities": {
    "Business": {
      "title": "Business",
      "description": "Isolated business workspace for HisabPro credit and recovery operations.",
      "type": "object",
      "properties": {
        "businessName": { "type": "string" },
        "businessCode": { "type": "string" },
        "ownerUid": { "type": "string" },
        "ownerName": { "type": "string" },
        "ownerMobile": { "type": "string" },
        "ownerEmail": { "type": "string" },
        "currency": { "type": "string", "enum": ["PKR"] },
        "timezone": { "type": "string", "enum": ["Asia/Karachi"] },
        "allowOverRecovery": { "type": "boolean" },
        "status": { "type": "string", "enum": ["ACTIVE", "SUSPENDED"] },
        "suspendedReason": { "type": "string" },
        "lastActivityMillis": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server timestamp via FieldValue.serverTimestamp()" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Server timestamp via FieldValue.serverTimestamp()" }
      },
      "required": ["businessName", "businessCode", "ownerUid", "ownerName", "ownerMobile", "currency", "timezone", "allowOverRecovery", "createdAt", "updatedAt"]
    },
    "LoginTicket": {
      "title": "LoginTicket",
      "description": "Salted PBKDF2-SHA256 credential verifier keyed by businessCode__username without PII or financial data.",
      "type": "object",
      "properties": {
        "businessId": { "type": "string" },
        "businessName": { "type": "string" },
        "businessCode": { "type": "string" },
        "accountId": { "type": "string" },
        "role": { "type": "string", "enum": ["SUPER_ADMIN", "STAFF", "BOOKER"] },
        "username": { "type": "string" },
        "fullName": { "type": "string" },
        "passwordSalt": { "type": "string" },
        "passwordHash": { "type": "string" },
        "mustChangePassword": { "type": "boolean" },
        "status": { "type": "string", "enum": ["ACTIVE", "SUSPENDED", "INACTIVE"] },
        "boundGoogleUid": { "type": "string" },
        "ownerUid": { "type": "string" },
        "sessionRevokedBeforeMillis": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["businessId", "businessName", "businessCode", "accountId", "role", "username", "fullName", "passwordSalt", "passwordHash", "mustChangePassword", "status", "boundGoogleUid", "ownerUid", "createdAt", "updatedAt"]
    },
    "UserWorkspaceBookmark": {
      "title": "UserWorkspaceBookmark",
      "description": "Saved business workspace reference scoped under a Google user's UID.",
      "type": "object",
      "properties": {
        "businessId": { "type": "string" },
        "businessName": { "type": "string" },
        "businessCode": { "type": "string" },
        "lastUsername": { "type": "string" },
        "lastRole": { "type": "string", "enum": ["SUPER_ADMIN", "STAFF", "BOOKER"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["businessId", "businessName", "businessCode", "lastUsername", "lastRole", "createdAt", "updatedAt"]
    },
    "WorkspaceMember": {
      "title": "WorkspaceMember",
