      },
      "required": ["businessId", "bookerCode", "fullName", "username", "mobileNumber", "status", "mustChangePassword", "createdAt", "updatedAt"]
    },
    "Shop": {
      "title": "Shop",
      "description": "Credit shop profile with immutable Shop UID and assigned Booker.",
      "type": "object",
      "properties": {
        "businessId": { "type": "string" },
        "shopUid": { "type": "string" },
