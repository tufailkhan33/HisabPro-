        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["businessId", "userId", "viewDashboard", "viewShops", "addShops", "editShops", "addCredit", "editCredit", "recordRecovery", "viewRecoveryHistory", "viewBookers", "manageBookers", "viewReports", "generatePdfs", "searchShops", "viewActivityLogs", "createdAt", "updatedAt"]
    },
    "Booker": {
