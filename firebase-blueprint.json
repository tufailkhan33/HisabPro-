        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["businessId", "txCode", "shopId", "shopUid", "shopName", "bookerId", "bookerName", "amountPaisa", "transactionKind", "paymentMethod", "txDateMillis", "txDateFormatted", "txTimeFormatted", "createdByAccountId", "createdByName", "createdByRole", "createdAt", "updatedAt"]
