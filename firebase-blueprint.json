        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["businessId", "userCode", "fullName", "username", "mobileNumber", "role", "status", "mustChangePassword", "createdAt", "updatedAt"]
    },
    "StaffPermission": {
      "title": "StaffPermission",
      "description": "Granular RBAC permissions for a business user account.",
