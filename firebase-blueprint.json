  "firestore": {
    "/platform_owner/{docId}": {
      "schema": { "$ref": "#/entities/PlatformOwnerConfig" },
      "description": "Permanent Platform Owner governance credentials (strictly bound to authorized Google email)"
    },
    "/platform_activity/{logId}": {
      "schema": { "$ref": "#/entities/PlatformActivityLog" },
      "description": "Immutable platform-wide owner activity logs"
    },
    "/platform_backups/{backupId}": {
      "schema": { "$ref": "#/entities/PlatformBackupSnapshot" },
      "description": "Platform-wide cloud backup manifests"
    },
    "/platform_backups/{backupId}/companies/{companyId}": {
      "schema": { "$ref": "#/entities/PlatformBackupCompanySnapshot" },
      "description": "Serialized isolated company snapshot for cloud restoration"
    },
    "/businesses/{businessId}": {
      "schema": { "$ref": "#/entities/Business" },
      "description": "Business workspaces"
    },
    "/login_tickets/{ticketId}": {
      "schema": { "$ref": "#/entities/LoginTicket" },
      "description": "Hashed login tickets keyed by businessCode__username"
    },
    "/users/{googleUid}/workspaces/{businessId}": {
      "schema": { "$ref": "#/entities/UserWorkspaceBookmark" },
      "description": "Saved workspaces per authenticated Google UID"
    },
    "/businesses/{businessId}/members/{googleUid}": {
      "schema": { "$ref": "#/entities/WorkspaceMember" },
      "description": "Authenticated workspace membership and active role binding"
    },
    "/businesses/{businessId}/users/{userId}": {
      "schema": { "$ref": "#/entities/BusinessUser" },
      "description": "Super Admin and Staff user profiles"
    },
    "/businesses/{businessId}/permissions/{userId}": {
      "schema": { "$ref": "#/entities/StaffPermission" },
      "description": "Per-user RBAC permission matrix"
    },
    "/businesses/{businessId}/bookers/{bookerId}": {
      "schema": { "$ref": "#/entities/Booker" },
      "description": "Field booker profiles"
    },
    "/businesses/{businessId}/shops/{shopId}": {
      "schema": { "$ref": "#/entities/Shop" },
      "description": "Credit shops within a business"
    },
    "/businesses/{businessId}/credit_transactions/{txId}": {
      "schema": { "$ref": "#/entities/CreditTransaction" },
      "description": "Immutable credit ledger entries and reversals"
    },
    "/businesses/{businessId}/recovery_transactions/{txId}": {
      "schema": { "$ref": "#/entities/RecoveryTransaction" },
      "description": "Immutable recovery ledger entries and reversals"
    },
    "/businesses/{businessId}/audit_logs/{logId}": {
      "schema": { "$ref": "#/entities/AuditLog" },
      "description": "Permanent append-only audit trail"
    },
    "/businesses/{businessId}/notifications/{notificationId}": {
      "schema": { "$ref": "#/entities/NotificationItem" },
      "description": "In-app role-scoped notifications"
    },
    "/businesses/{businessId}/business_settings/{settingId}": {
      "schema": { "$ref": "#/entities/BusinessSettings" },
      "description": "Business-wide financial and operational settings"
    },
    "/businesses/{businessId}/chat_groups/{groupId}": {
      "schema": { "$ref": "#/entities/ChatGroup" },
      "description": "Admin-created team meeting and group chats"
    },
    "/businesses/{businessId}/chat_groups/{groupId}/messages/{messageId}": {
      "schema": { "$ref": "#/entities/ChatMessage" },
      "description": "Immutable text, voice, photo, and file messages in team groups"
    }
  }
}
