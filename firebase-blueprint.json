        "editCredit": { "type": "boolean" },
        "recordRecovery": { "type": "boolean" },
        "viewRecoveryHistory": { "type": "boolean" },
        "viewBookers": { "type": "boolean" },
        "manageBookers": { "type": "boolean" },
