        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["businessId", "googleUid", "accountId", "username", "fullName", "role", "bookerId", "status", "claimedTicketId", "createdAt", "updatedAt"]
    },
    "BusinessUser": {
      "title": "BusinessUser",
