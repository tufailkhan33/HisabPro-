      "required": ["businessId", "txCode", "shopId", "shopUid", "shopName", "bookerId", "bookerName", "amountPaisa", "transactionKind", "txDateMillis", "txDateFormatted", "txTimeFormatted", "createdByAccountId", "createdByName", "createdByRole", "createdAt", "updatedAt"]
