      "required": ["businessId", "shopUid", "shopName", "bookerId", "bookerName", "ownerName", "mobileNumber", "address", "city", "openingCreditPaisa", "openingDateMillis", "isArchived", "createdByAccountId", "createdByName", "createdAt", "updatedAt"]
